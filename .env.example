NOOKIPEDIA_API_KEY=your_nookipedia_api_key

# Optional
# PREWARM_ON_STARTUP=1
# NOOKIPEDIA_CACHE_TTL_SEC=86400
# DB_PATH=app.db
# CONTENT_BACKEND=auto
# STATE_BACKEND=auto
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# APP_TIMEZONE=Asia/Seoul
