{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/index.py": {
      "maxDuration": 30,
      "includeFiles": "{static/index.html,static/app.js,static/styles.css,static/js/**,static/icons/**,static/no-image.svg,static/assets/music/**,data/**,content.db}",
      "excludeFiles": "{.git/**,.github/**,.venv/**,__pycache__/**,docs/**,villagers/**,app.db*,server*.log,data/.cache/**}"
    }
  }
}
